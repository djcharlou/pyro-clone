{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pyro-clone",
  "version": "0.3.0",
  "identifier": "com.djcharlou.pyroclone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pyro-clone",
        "width": 1200,
        "height": 820,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "backgroundColor": "#b91d12",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Local-file automix DJ (Serato Pyro-like)",
    "longDescription": "Import your local audio library, analyze BPM/key/energy, and let pyro auto-mix your set with beat-matched crossfades.",
    "copyright": "© 2026 djcharlou",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": null,
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
